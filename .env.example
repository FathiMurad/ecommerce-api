# Database Infrastructure Credentials
DB_NAME=ecommerce_db
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME

# JWT Authentication Key (HMAC-SHA256, 256-bit key)
JWT_SECRET_KEY=CHANGE_ME

# Application Security Pepper (Global Cryptographic Key for HMAC-SHA256)
SECURITY_PEPPER=CHANGE_ME

# Initial System Administrator Credentials (leave empty to skip admin bootstrap)
ADMIN_EMAIL=CHANGE_ME
ADMIN_PASSWORD=CHANGE_ME

# Initial Demo Customer Credentials (leave empty to skip customer bootstrap)
CUSTOMER_EMAIL=CHANGE_ME
CUSTOMER_PASSWORD=CHANGE_ME

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Swagger / OpenAPI documentation
SWAGGER_ENABLED=true