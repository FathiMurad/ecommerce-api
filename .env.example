# Database Infrastructure Credentials
DB_NAME=ecommerce_db
DB_USERNAME=postgres
DB_PASSWORD=

# JWT Authentication Key (HMAC-SHA256, 256-bit key)
JWT_SECRET_KEY=

# Application Security Pepper (Global Cryptographic Key for HMAC-SHA256)
SECURITY_PEPPER=

# Initial System Administrator Credentials
ADMIN_EMAIL=admin@supermarket.com
ADMIN_PASSWORD=

# Initial Test Customer Credentials
CUSTOMER_EMAIL=customer@supermarket.com
CUSTOMER_PASSWORD=

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Swagger / OpenAPI documentation
SWAGGER_ENABLED=true